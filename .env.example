# ---- AI provider -------------------------------------------------------------
# claude-code   = Claude Agent SDK using your local Claude Code login (testing only, no API key)
# anthropic-api = Anthropic API with ANTHROPIC_API_KEY (production)
AI_PROVIDER=claude-code
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
# Max model steps (tool-call round trips) per chat turn
AI_MAX_STEPS=40
# anthropic-api only: server-side refusal fallback (on by default; set to "off" to disable)
AI_FALLBACKS=on

# Required only when AI_PROVIDER=anthropic-api
ANTHROPIC_API_KEY=

# ---- Database ------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---- Auth ------------------------------------------------------------------------
# Random string, 32+ characters. Signs session cookies and preview links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
