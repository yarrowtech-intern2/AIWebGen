// AgentWebBuilder data model. See docs/ARCHITECTURE.md §7.
// SQLite in development; switch `provider` to "postgresql" for production.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  projects     Project[]
  integrations Integration[]
}

/// A connected third-party account (GitHub, Vercel). Tokens are AES-256-GCM encrypted.
model Integration {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // "github" | "vercel"
  tokenEncrypted String
  accountName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, provider])
}

model Project {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  kit              String // "static" | "react-vite" | …
  templateSlug     String?
  currentVersionId String?
  /// Let Claude use the user's GitHub tools (MCP) in this project's chat.
  githubToolsEnabled Boolean @default(false)
  /// Last publish settings, reused by the next Publish.
  publishTarget    String? // "github-pages" | "vercel"
  githubRepo       String? // "owner/name"
  publishedUrl     String?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  files            ProjectFile[]
  versions         Version[]
  messages         ChatMessage[]

  @@index([userId])
}

/// Working copy of the project's files.
model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  content   String
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
}

/// Full snapshot of all files after an AI turn, manual save, template copy or restore.
model Version {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  source    String // "ai" | "manual" | "template" | "restore"
  summary   String
  snapshot  String // JSON: { [path]: content }
  createdAt DateTime @default(now())

  @@unique([projectId, number])
}

model ChatMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String // display text
  raw       String? // provider-native blocks (JSON) for multi-turn context
  versionId String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}
